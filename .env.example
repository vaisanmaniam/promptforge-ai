# ==============================================================================
# PromptForge AI - Environment Configuration Template
# Copy this file to .env and adjust variables for your local setup.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="PromptForge AI"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=promptforge_user
POSTGRES_PASSWORD=promptforge_secure_dev_password
POSTGRES_DB=promptforge_db
# SQLAlchemy connection string is automatically assembled from above if omitted
# DATABASE_URL=postgresql+asyncpg://promptforge_user:promptforge_secure_dev_password@localhost:5432/promptforge_db

# Local AI Inference Runtime Configuration (Local-first, provider-independent)
# Default is Ollama running locally; can point to any OpenAI-compatible local runner (llama.cpp server, vLLM)
AI_RUNTIME_BASE_URL=http://localhost:11434
AI_RUNTIME_TIMEOUT_SECONDS=5.0
AI_CODE_MODEL_NAME=qwen2.5-coder:1.5b
AI_CLASSIFIER_MODEL_NAME=prompt-classifier-v1

# Model Artifacts Directory
AI_MODELS_DIR=./ai/models

# Execution Sandbox Configuration (Docker-based execution isolation)
SANDBOX_ENABLED=false
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_NETWORK_ACCESS=false
